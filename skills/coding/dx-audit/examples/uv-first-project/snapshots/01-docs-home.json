  "codeBlocks": [
    {
      "text": "$ curl -LsSf https://astral.sh/uv/install.sh | sh",
      "lang": null,
      "heading": "Installation",
      "copyButton": true,
      "lines": 1
    },
    {
      "text": "$ uv init example\nInitialized project `example` at `/home/user/example`\n\n$ cd example\n\n$ uv add ruff\nCreating virtual environment at: .venv\nResolved 2 packages in 170ms\n   Built example @ file:///home/user/example\nPrepared 2 packages in 627ms\nInstalled 2 packages in 1ms\n + example==0.1.0 (from file:///home/user/example)\n + ruff==0.5.4\n\n$ uv run ruff check\nAll checks passed!\n\n$ uv lock\nResolved 2 packages in 0.33ms\n\n$ uv sync\nResolved 2 packages in 0.70ms\nChecked 1 package in 0.02ms",
      "lang": null,
      "heading": "Projects",
      "copyButton": true,
      "lines": 23
    },
    {
      "text": "$ echo 'import requests; print(requests.get(\"https://astral.sh\"))' > example.py\n\n$ uv add --script example.py requests\nUpdated `example.py`",
      "lang": null,
      "heading": "Scripts",
      "copyButton": true,
      "lines": 4
    },
    {
      "text": "$ uv run example.py\nReading inline script metadata from: example.py\nInstalled 5 packages in 12ms\n<Response [200]>",
      "lang": null,
      "heading": "Scripts",
      "copyButton": true,
      "lines": 4
    },
    {
      "text": "$ uvx pycowsay 'hello world!'\nResolved 1 package in 167ms\nInstalled 1 package in 9ms\n + pycowsay==0.0.0.2\n  \"\"\"\n\n  ------------\n< hello world! >\n  ------------\n   \\   ^__^\n    \\  (oo)\\_______\n       (__)\\       )\\/\\\n           ||----w |\n           ||     ||",
      "lang": null,
      "heading": "Tools",
      "copyButton": true,
      "lines": 14
    },
    {
      "text": "$ uv tool install ruff\nResolved 1 package in 6ms\nInstalled 1 package in 2ms\n + ruff==0.5.4\nInstalled 1 executable: ruff\n\n$ ruff --version\nruff 0.5.4",
      "lang": null,
      "heading": "Tools",
      "copyButton": true,
      "lines": 8
    },
    {
      "text": "$ uv python install 3.10 3.11 3.12\nSearching for Python versions matching: Python 3.10\nSearching for Python versions matching: Python 3.11\nSearching for Python versions matching: Python 3.12\nInstalled 3 versions in 3.42s\n + cpython-3.10.14-macos-aarch64-none\n + cpython-3.11.9-macos-aarch64-none\n + cpython-3.12.4-macos-aarch64-none",
      "lang": null,
      "heading": "Python versions",
      "copyButton": true,
      "lines": 8
    },
    {
      "text": "$ uv venv --python 3.12.0\nUsing CPython 3.12.0\nCreating virtual environment at: .venv\nActivate with: source .venv/bin/activate\n\n$ uv run --python pypy@3.8 -- python\nPython 3.8.16 (a9dbdca6fc3286b0addd2240f11d97d8e8de187a, Dec 29 2022, 11:45:30)\n[PyPy 7.3.11 with GCC Apple LLVM 13.1.6 (clang-1316.0.21.2.5)] on darwin\nType \"help\", \"copyright\", \"credits\" or \"license\" for more information.\n>>>>",
      "lang": null,
      "heading": "Python versions",
      "copyButton": true,
      "lines": 10
    },
    {
      "text": "$ uv python pin 3.11\nPinned `.python-version` to `3.11`",
      "lang": null,
      "heading": "Python versions",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": "$ uv pip compile requirements.in \\\n   --universal \\\n   --output-file requirements.txt\nResolved 43 packages in 12ms",
