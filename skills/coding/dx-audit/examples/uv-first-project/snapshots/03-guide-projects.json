  "codeBlocks": [
    {
      "text": "$ uv init hello-world\n$ cd hello-world",
      "lang": null,
      "heading": "Creating a new project",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": "$ mkdir hello-world\n$ cd hello-world\n$ uv init",
      "lang": null,
      "heading": "Creating a new project",
      "copyButton": true,
      "lines": 3
    },
    {
      "text": "├── .git/\n├── .gitignore\n├── .python-version\n├── pyproject.toml\n├── README.md\n└── src\n    └── hello_world\n        └── __init__.py",
      "lang": null,
      "heading": "Creating a new project",
      "copyButton": true,
      "lines": 8
    },
    {
      "text": "$ uv run hello-world\nHello from hello-world!",
      "lang": null,
      "heading": "Creating a new project",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": ".\n├── .git/\n├── .venv/\n│   ├── bin\n│   ├── lib\n│   └── pyvenv.cfg\n├── .gitignore\n├── .python-version\n├── README.md\n├── src\n│   └── hello_world\n│       └── __init__.py\n├── pyproject.toml\n└── uv.lock",
      "lang": null,
      "heading": "Project structure",
      "copyButton": true,
      "lines": 14
    },
    {
      "text": "[project]\nname = \"hello-world\"\nversion = \"0.1.0\"\ndescription = \"Add your description here\"\nreadme = \"README.md\"\nauthors = [\n  { name = \"ferris\", email = \"ferris@example.org\" }\n]\nrequires-python = \">=3.14\"\ndependencies = []\n\n[project.scripts]\nhello-world = \"hello_world:main\"\n\n[build-system]\nrequires = [\"uv_build>=0.13.7,<0.14\"]\nbuild-backend = \"uv_build\"",
      "lang": null,
      "heading": "pyproject.toml",
      "copyButton": true,
      "lines": 17
    },
    {
      "text": "$ uv add requests",
      "lang": null,
      "heading": "Managing dependencies",
      "copyButton": true,
      "lines": 1
    },
    {
      "text": "$ # Specify a version constraint\n$ uv add 'requests==2.31.0'\n\n$ # Add a git dependency\n$ uv add git+https://github.com/psf/requests",
      "lang": null,
      "heading": "Managing dependencies",
      "copyButton": true,
      "lines": 5
    },
    {
      "text": "$ # Add all dependencies from `requirements.txt`.\n$ uv add -r requirements.txt -c constraints.txt",
      "lang": null,
      "heading": "Managing dependencies",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": "$ uv remove requests",
      "lang": null,
      "heading": "Managing dependencies",
      "copyButton": true,
      "lines": 1
    },
    {
      "text": "$ uv lock --upgrade-package requests",
      "lang": null,
      "heading": "Managing dependencies",
      "copyButton": true,
      "lines": 1
    },
    {
      "text": "$ uv version\nhello-world 0.7.0",
      "lang": null,
      "heading": "Viewing your version",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": "$ uv version --short\n0.7.0",
      "lang": null,
      "heading": "Viewing your version",
      "copyButton": true,
      "lines": 2
    },
    {
      "text": "$ uv version --output-format json\n{\n    \"package_name\": \"hello-world\",\n    \"version\": \"0.7.0\",\n    \"commit_info\": null\n}",
      "lang": null,
      "heading": "Viewing your version",
      "copyButton": true,
      "lines": 6
    },
